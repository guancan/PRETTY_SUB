# UniAPI Key for Whisper-1 and Gemini segmentation forwarding
UNIAPI_KEY=

# Transcription provider: whisper | doubao-flash
TRANSCRIPTION_PROVIDER=whisper

# Doubao flash ASR configuration.
# Use the speech service API key for X-Api-Key. Do not commit real secrets.
DOUBAO_API_KEY=
DOUBAO_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_UID=pretty-sub-local
DOUBAO_RECOGNIZE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash

# Gemini model for segmentation (default: gemini-2.5-flash)
GEMINI_SEGMENTATION_MODEL=gemini-2.5-flash

# UniAPI Gemini forwarding base URL for @google/genai (default: https://api.uniapi.io/gemini)
UNIAPI_GEMINI_BASE_URL=https://api.uniapi.io/gemini

# Enable AI segmentation debug logging (default: false)
# Set to 'true' to log detailed AI request/response information
DEBUG_AI_SEGMENTATION=false
